# Host address used to publish the console. 0.0.0.0 makes host TCP/8080 manageable by the host firewall.
PLATFORM_BIND_IP=0.0.0.0
# Host-published console port used by access mode 2. Do not set this to 80 or 443.
PLATFORM_PORT=8080
# Optional access-mode override: apps_only (mode 2) or all_caddy (mode 1).
# Leave empty to switch in Website Settings. The database default is apps_only.
GATEWAY_ACCESS_MODE=
# Caddy always accepts public HTTP/HTTPS on TCP 80/443 and HTTP/3 on UDP 443.
GATEWAY_BIND_IP=0.0.0.0
# Space-separated source CIDRs from which Caddy may trust X-Forwarded-*.
# Keep this restricted to explicitly trusted upstream proxies if Caddy is placed behind another load balancer.
GATEWAY_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Caddy Admin API is internal-only. Override only for a custom topology.
CADDY_ADMIN_URL=http://gateway:2019
CADDYFILE_PATH=/etc/cloudmeter/runtime/Caddyfile
# API only receives traffic from the internal gateway and trusts that network for normalized proxy headers.
API_TRUSTED_PROXY_CIDRS=172.16.0.0/12
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
SESSION_TTL_HOURS=24
# Generate once with: openssl rand -base64 32 | tr -d '=\n'
# Keep this value stable; changing it makes stored SMTP/OAuth/payment credentials unreadable.
SECRETS_ENCRYPTION_KEY=replace-with-base64-no-padding-32-byte-key
DOCKER_EXECUTOR_ENABLED=false
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_GID=0
# Compose injects its project name automatically. Override only for advanced
# migrations where multiple project names must deliberately share a runtime.
# RUNTIME_OWNER=cloudmeter
ROUTER_INTERNAL_TOKEN=replace-with-a-third-long-random-password
EGRESS_INGEST_TOKEN=replace-with-a-fourth-long-random-password
BACKUP_STORAGE_VOLUME=cloudmeter_backup_data
# Docker volume mounted by the API for backup import/export. In the production
# project this must match BACKUP_STORAGE_VOLUME. Isolated projects should set
# both values to the same project-scoped volume name.
BACKUP_STORAGE_MOUNT_VOLUME=cloudmeter_backup_data
BACKUP_HELPER_IMAGE=nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
