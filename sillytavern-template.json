{
  "product": {
    "name": "SillyTavern 酒馆",
    "slug": "sillytavern",
    "iconUrl": "https://sillytavern.app/favicon.png"
  },
  "version": {
    "versionLabel": "v1.16.0 稳定版",
    "imageDigest": "ghcr.io/sillytavern/sillytavern:1.16.0",
    "runtimeSpec": {
      "cpuCores": 0.5,
      "memoryMiB": 512,
      "dataVolumeGiB": 8,
      "editableOptions": {
        "cpu": true,
        "memory": true,
        "dataVolume": true,
        "command": false,
        "dependencies": false
      },
      "env": {
        "NODE_ENV": "production",
        "FORCE_COLOR": "1",
        "SILLYTAVERN_LISTEN": "true",
        "SILLYTAVERN_PORT": "8000",
        "SILLYTAVERN_HEARTBEATINTERVAL": "30",
        "SILLYTAVERN_WHITELISTMODE": "false",
        "SILLYTAVERN_SECURITYOVERRIDE": "true"
      },
      "envDescriptions": {
        "NODE_ENV": "使用生产模式运行 SillyTavern",
        "FORCE_COLOR": "保留容器日志中的彩色级别标识",
        "SILLYTAVERN_LISTEN": "启用远程监听，允许平台网关访问容器服务",
        "SILLYTAVERN_PORT": "容器 HTTP 服务端口",
        "SILLYTAVERN_HEARTBEATINTERVAL": "WebSocket 心跳间隔，单位为秒",
        "SILLYTAVERN_WHITELISTMODE": "关闭访问白名单，访问控制由平台网关负责",
        "SILLYTAVERN_SECURITYOVERRIDE": "允许非本机监听，认证边界由平台网关负责"
      },
      "editableEnvKeys": [],
      "secretKeys": [],
      "secretDescriptions": {},
      "editableSecretKeys": [],
      "command": [],
      "volumes": [
        {
          "name": "data",
          "mountPath": "/home/node/app/data",
          "sizeGiB": 8
        }
      ],
      "dependencies": []
    },
    "routeSpec": {
      "containerPort": 8000,
      "basePath": "/",
      "websocket": true,
      "sse": true
    },
    "healthSpec": {
      "path": "/",
      "intervalSeconds": 30,
      "timeoutSeconds": 10,
      "acceptedStatusCodes": [200]
    },
    "updateSpec": {
      "dataPolicy": "volume_compatible"
    }
  }
}
