{
  "product": {
    "name": "SillyTavern 酒馆",
    "slug": "sillytavern",
    "iconUrl": "https://sillytavern.app/favicon.png"
  },
  "version": {
    "versionLabel": "v1.0 基础版",
    "imageDigest": "ghcr.io/sillytavern/sillytavern:latest",
    "runtimeSpec": {
      "cpuCores": 0.5,
      "memoryMiB": 512,
      "dataVolumeGiB": 4,
      "editableOptions": {
        "cpu": true,
        "memory": true,
        "dataVolume": true,
        "command": false,
        "dependencies": false
      },
      "env": {
        "NODE_ENV": "production",
        "FORCE_COLOR": "1",
        "SILLYTAVERN_HEARTBEATINTERVAL": "30",
        "SILLYTAVERN_WHITELISTMODE": "false",
        "SILLYTAVERN_SECURITYOVERRIDE": "true"
      },
      "envDescriptions": {
        "NODE_ENV": "使用生产模式运行 SillyTavern",
        "FORCE_COLOR": "保留容器日志中的彩色级别标识",
        "SILLYTAVERN_HEARTBEATINTERVAL": "WebSocket 心跳间隔，单位为秒",
        "SILLYTAVERN_WHITELISTMODE": "关闭访问白名单，允许平台网关反向代理与健康检查访问",
        "SILLYTAVERN_SECURITYOVERRIDE": "跳过非本机监听的内部安全拦截，由平台网关提供认证边界"
      },
      "editableEnvKeys": [],
      "secretKeys": [],
      "secretDescriptions": {},
      "editableSecretKeys": [],
      "command": [],
      "volumes": [
        {
          "name": "data",
          "mountPath": "/home/node/app/data",
          "sizeGiB": 4
        },
        {
          "name": "config",
          "mountPath": "/home/node/app/config",
          "sizeGiB": 4
        },
        {
          "name": "plugins",
          "mountPath": "/home/node/app/plugins",
          "sizeGiB": 4
        },
        {
          "name": "extensions",
          "mountPath": "/home/node/app/public/scripts/extensions/third-party",
          "sizeGiB": 4
        }
      ],
      "dependencies": []
    },
    "routeSpec": {
      "containerPort": 8000,
      "basePath": "/",
      "stripPrefix": true,
      "websocket": true,
      "sse": true,
      "cookiePath": "/"
    },
    "healthSpec": {
      "path": "/",
      "intervalSeconds": 30,
      "timeoutSeconds": 10,
      "acceptedStatusCodes": [200]
    },
    "updateSpec": {
      "dataPolicy": "volume_compatible"
    }
  }
}
