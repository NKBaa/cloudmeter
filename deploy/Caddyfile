{
	auto_https off
	# The admin API is reachable only from platform_network. It is never
	# published on the host and is proxied through authenticated API handlers.
	admin 0.0.0.0:2019
	servers {
		trusted_proxies static {$GATEWAY_TRUSTED_PROXY_CIDRS}
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	# Bootstrap in applications-only mode. Saving Website Settings replaces
	# this source through Caddy's Admin API and persists the active config.
	handle {
		reverse_proxy {
			dynamic a app-router 8082 {
				refresh 5s
				versions ipv4
			}
			header_up X-Forwarded-For {http.request.client_ip}
			header_up X-CloudMeter-Router-Token {$ROUTER_INTERNAL_TOKEN}
			header_up X-CloudMeter-Route-Mode subdomain
		}
	}
}
